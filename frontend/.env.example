VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_BASE_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
# Set to "true" only for local development if Clerk isn't configured yet -
# must match AUTH_DEV_BYPASS on the backend. Never enable in production.
VITE_AUTH_DEV_BYPASS=false
# Optional. Free CARTO basemap key (no account needed): https://carto.com/basemaps/apikey/
# Set it to get the original dark CARTO map. Leave empty to use OpenStreetMap
# tiles darkened in the browser (no key needed, no watermark).
VITE_CARTO_API_KEY=
