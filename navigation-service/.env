# Internal shared secret — the Node backend must send this in the
# X-Internal-Token header on every call. Generate with: openssl rand -hex 32
PRAHARI_INTERNAL_TOKEN=c5361c5628c88d673c75b38c2914b9703eb6bc66c0d4e5cc4b6e0b0c307f149d

# Comma-separated list of origins allowed to call this service directly
# (normally only the Node backend's own origin, never the browser).
PRAHARI_CORS_ORIGINS=http://localhost:4000

# Areas to pre-build ("warm") on startup: name:lat:lon:radius_m, ";"-separated
PRAHARI_WARM_AREAS=bengaluru_core:12.9634:77.5975:6000

# Where built area graphs are persisted (mount a volume here in production)
PRAHARI_DATA_DIR=/app/data/areas

PRAHARI_WALKING_SPEED_KMH=4.5
PRAHARI_DRIVING_SPEED_KMH=22
