
require("dotenv").config();

const twilio = require("twilio");

async function main() {
  const { TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_FROM } =
    process.env;

  if (!TWILIO_ACCOUNT_SID || !TWILIO_AUTH_TOKEN || !TWILIO_WHATSAPP_FROM) {
    throw new Error("Missing Twilio environment variables. Check your .env file.");
  }

  const client = twilio(
    TWILIO_ACCOUNT_SID,
    TWILIO_AUTH_TOKEN
  );

  // Replace this with your own WhatsApp number that joined
  // the Twilio Sandbox, using international format.
  const recipient = "whatsapp:+91YOUR_NUMBER";

  const message = await client.messages.create({
    from: TWILIO_WHATSAPP_FROM,
    to: recipient,
    body:
      "Hello! This is a test message from PRAHARI. " +      "WhatsApp SOS notification setup is being tested."
  });

  console.log("Message submitted to Twilio.");
  console.log("Message SID:", message.sid);
  console.log("Initial status:", message.status);
}

main().catch((error) => {
  console.error("WhatsApp test failed:", error.message);
  process.exitCode = 1;
});

