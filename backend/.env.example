# ---------- Server ----------
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# ---------- Database (Neon PostgreSQL) ----------
# Get both from your Neon project dashboard -> Connection Details.
# DATABASE_URL = pooled connection (used by the running app)
# DIRECT_URL   = direct/unpooled connection (used by `prisma migrate`)
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-PROJECT.neon.tech/prahari?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-PROJECT.neon.tech/prahari?sslmode=require"

# ---------- Auth (Clerk) ----------
# From your Clerk dashboard -> API Keys.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to "true" ONLY for local development when you don't yet have Clerk keys
# configured. See src/middleware/auth.js — this creates/uses a single fixed
# dev user and must never be enabled in production.
AUTH_DEV_BYPASS=false

# ---------- Navigation microservice (Python/FastAPI) ----------
NAVIGATION_SERVICE_URL=http://localhost:8000
NAVIGATION_SERVICE_TOKEN=changeme-generate-a-real-secret

# ---------- Security ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---------- Per-user write limits (in addition to per-IP above) ----------
PER_USER_INCIDENT_WINDOW_MS=600000
PER_USER_INCIDENT_MAX=5
PER_USER_POST_WINDOW_MS=600000
PER_USER_POST_MAX=10

# ---------- SOS notification channels ----------
# Leave blank to run in simulated/dev mode (logged, clearly marked
# "simulated" in API responses — never silently pretends to send).

# Twilio (SMS) — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP (email) — works with SendGrid, Postmark, SES, or a Gmail app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@prahari.app

LOG_LEVEL=debug

# ---------- Place search (suggestions / lookups) ----------
# Identify the app to the free OpenStreetMap-based services (their policy asks
# for this). Put a contact email in it for anything beyond local development.
GEOCODER_USER_AGENT="PRAHARI-safety-navigation/1.0 (you@example.com)"
# Minimum gap between calls to each public service (fair use: ~1/second)
GEOCODER_MIN_INTERVAL_MS=1000
# PHOTON_URL=https://photon.komoot.io
# NOMINATIM_URL=https://nominatim.openstreetmap.org
